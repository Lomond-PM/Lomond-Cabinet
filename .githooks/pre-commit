#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
temp_root=$(mktemp -d)

cleanup() {
    rm -rf "$temp_root"
}

trap cleanup EXIT HUP INT TERM

git -C "$repo_root" checkout-index \
    --all \
    --force \
    --prefix="$temp_root/"

cd "$temp_root"
node scripts/report-i18n-usage.js --check
